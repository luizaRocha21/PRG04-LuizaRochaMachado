# Copie este arquivo para ".env.local" (ele já é ignorado pelo Git) e ajuste o valor.
#
# URL COMPLETA da API de usuários, incluindo o caminho /api/usuarios.
# O Vite embute esta variável no momento do build.

# Desenvolvimento: backend Spring Boot rodando na sua máquina (porta 8080)
VITE_API_URL=http://localhost:8080/api/usuarios

# Produção (Vercel -> Settings -> Environment Variables): URL do serviço no Render
# VITE_API_URL=https://unibus-api.onrender.com/api/usuarios
